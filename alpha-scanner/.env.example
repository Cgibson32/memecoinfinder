# ===========================================
# AlphaScanner Configuration
# ===========================================

# --- Required ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# --- Optional: Telegram Group Monitoring (Telethon) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated Telegram group usernames to monitor for alpha calls
TELEGRAM_ALPHA_GROUPS=

# --- Optional: Nitter instance for Twitter/CT monitoring ---
# Default: https://nitter.net
NITTER_INSTANCE=

# --- Optional: Override scoring weights (must sum to 1.0) ---
WEIGHT_VOLUME=0.15
WEIGHT_SOCIAL=0.12
WEIGHT_HOLDER=0.12
WEIGHT_SAFETY=0.13
WEIGHT_LIQUIDITY=0.08
WEIGHT_SMART_MONEY=0.15
WEIGHT_NARRATIVE=0.10
WEIGHT_CREDIBILITY=0.15

# --- Optional: Override filter thresholds ---
MIN_LIQUIDITY_USD=5000
MAX_AGE_HOURS=72
MIN_AGE_MINUTES=5
MIN_TRANSACTIONS_1H=20
MAX_SELL_TAX_PERCENT=10
MAX_BUY_TAX_PERCENT=10
MAX_TOP10_HOLDER_PERCENT=50

# --- Optional: Exit alert thresholds ---
EXIT_HOLDER_DROP_PCT=10
EXIT_LP_DROP_PCT=20
EXIT_VOLUME_CRASH_RATIO=0.2
EXIT_PRICE_DROP_PCT=50

# --- Optional: Chains to monitor (comma-separated) ---
ACTIVE_CHAINS=solana,ethereum,base,bsc
